# Normalize line endings to LF in the repository, CRLF on Windows checkout
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.bicep text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.env text eol=lf
*.http text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
